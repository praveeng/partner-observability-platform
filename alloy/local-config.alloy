// LOCAL_SYNTHETIC schema-2 data plane. The ingress gateway, not event content,
// selects one of these fixed receivers. Each pipeline independently validates,
// sanitizes, bounds, and exports to one fixed Loki tenant.

otelcol.receiver.otlp "partner_a" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    logs = [otelcol.processor.filter.partner_a.input]
  }
}

otelcol.receiver.otlp "partner_b" {
  http {
    endpoint = "0.0.0.0:4319"
  }
  output {
    logs = [otelcol.processor.filter.partner_b.input]
  }
}

otelcol.receiver.otlp "partner_c" {
  http {
    endpoint = "0.0.0.0:4320"
  }
  output {
    logs = [otelcol.processor.filter.partner_c.input]
  }
}

// Conditions are intentionally duplicated per fixed route. A generated market
// manifest will own this repetition in ECS; local static configuration keeps the
// trust boundary reviewable without a runtime/default tenant selector.
otelcol.processor.filter "partner_a" {
  error_mode = "propagate"
  logs {
    log_record = [
      `resource.attributes["service.name"] != "synthetic-partner-service"`,
      `resource.attributes["market"] != "LOCAL"`,
      `resource.attributes["deployment.environment"] != "LOCAL_SYNTHETIC"`,
      `attributes["partner.key"] != "partner-a"`,
      `not IsString(body)`,
      `Len(body) > 65536`,
      `not IsMatch(body, "^\\s*\\{")`,
      `not (attributes["schema.version"] == 1 or attributes["schema.version"] == 2)`,
      `attributes["schema.version"] == 1 and not IsMatch(attributes["event.type"], "^(partner_api_request|partner_api_response|partner_event)$")`,
      `attributes["schema.version"] == 2 and not IsMatch(attributes["event.type"], "^(outbound_api_request|outbound_api_response|async_acknowledgement|callback_request|callback_response|callback_processing_event|partner_business_event)$")`,
      `not IsMatch(attributes["event.domain"], "^(API|ASYNC|CALLBACK|BUSINESS)$")`,
      `not IsMatch(attributes["direction"], "^(OUTBOUND_TO_PARTNER|INBOUND_FROM_PARTNER)$")`,
      `not IsMatch(attributes["outcome"], "^(SUCCESS|BUSINESS_REJECTED|TECHNICAL_FAILURE|CANCELLED|UNKNOWN)$")`,
      `not IsMatch(attributes["severity"], "^(INFO|WARN|ERROR)$")`,
      `not IsMatch(attributes["event.id"], "^[0-9a-f-]{36}$")`,
      `not IsMatch(attributes["interaction.id"], "^[0-9a-f-]{36}$")`,
      `not IsMatch(attributes["correlation.profile.id"], "^[A-Za-z0-9._-]{1,63}$")`,
      `not IsMatch(attributes["api.id"], "^[A-Za-z0-9._-]{1,63}$")`,
      `attributes["application.id"] != nil and not IsMatch(attributes["application.id"], "^[A-Za-z0-9._-]{1,128}$")`,
      `attributes["loan.id"] != nil and not IsMatch(attributes["loan.id"], "^[A-Za-z0-9._-]{1,128}$")`,
      `attributes["correlation.id"] != nil and not IsMatch(attributes["correlation.id"], "^[A-Za-z0-9._-]{1,128}$")`,
      `attributes["original.correlation.id"] != nil and not IsMatch(attributes["original.correlation.id"], "^[A-Za-z0-9._-]{1,128}$")`,
      `attributes["request.id"] != nil and not IsMatch(attributes["request.id"], "^[A-Za-z0-9._-]{1,128}$")`,
      `attributes["partner.reference.id"] != nil and not IsMatch(attributes["partner.reference.id"], "^[A-Za-z0-9._-]{1,128}$")`,
      `attributes["callback.reference.id"] != nil and not IsMatch(attributes["callback.reference.id"], "^[A-Za-z0-9._-]{1,128}$")`,
      `attributes["external.transaction.id"] != nil and not IsMatch(attributes["external.transaction.id"], "^[A-Za-z0-9._-]{1,128}$")`,
      `IsMatch(body, "(?i)\\\"[^\\\"]*(authorization|proxy.?authorization|password|passcode|secret|token|jwt|cookie|session|api.?key|otp|one.?time|verification.?code|cvv|cvc|card.?number|private.?key|signing.?key|encryption.?key)[^\\\"]*\\\"\\s*:")`,
      `IsMatch(body, "(?i)(bearer|basic)\\s+[A-Za-z0-9._~+/-]+")`,
      `IsMatch(body, "(?i)-----BEGIN [A-Z ]*(PRIVATE KEY|CERTIFICATE)-----")`,
      `IsMatch(body, "(?i)data:[^;\\\"]+;base64,")`,
      `IsMatch(body, "\\\"[A-Za-z0-9+/]{32,}={0,2}\\\"")`,
      `IsMatch(body, "\\\"[0-9]{13,19}\\\"")`,
    ]
  }
  output {
    logs = [otelcol.processor.transform.partner_a.input]
  }
}

