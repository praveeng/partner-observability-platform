otelcol.processor.transform "partner_a" {
  error_mode = "propagate"
  log_statements {
    context = "log"
    statements = [
      `replace_pattern(log.body, "(?i)(\\\"(?:phone|mobile|telephone)\\\"\\s*:\\s*\\\")[^\\\"]*(\\\")", "$1[MASKED_PHONE]$2")`,
      `replace_pattern(log.body, "(?i)(\\\"email\\\"\\s*:\\s*\\\")[^\\\"]*(\\\")", "$1[MASKED_EMAIL]$2")`,
      `replace_pattern(log.body, "(?i)(\\\"(?:account|account.?number|acct.?no|bank.?account(?:.?number)?|iban)\\\"\\s*:\\s*\\\")[^\\\"]*(\\\")", "$1[MASKED_ACCOUNT]$2")`,
      `replace_pattern(log.body, "(?i)(\\\"(?:national.?id(?:entifier)?|government.?id|tax.?id(?:entifier)?|ssn|social.?security.?number|passport.?number)\\\"\\s*:\\s*\\\")[^\\\"]*(\\\")", "$1[MASKED_NATIONAL_ID]$2")`,
      `replace_pattern(log.body, "(?i)(\\\"(?:address|postal.?address|street.?address|home.?address|mailing.?address|residential.?address|billing.?address)\\\"\\s*:\\s*\\\")[^\\\"]*(\\\")", "$1[MASKED_ADDRESS]$2")`,
      `merge_maps(log.cache, ParseJSON(log.body), "upsert")`,
      `delete_key(log.cache, "partnerKey")`,
      `delete_key(log.cache, "partnerId")`,
      `delete_key(log.cache, "tenantRouteId")`,
      `delete_key(log.cache, "xScopeOrgId")`,
      `set(log.body, log.cache)`,
      `set(log.severity_text, "")`,
      `set(log.observed_time_unix_nano, 0)`,
      `set(instrumentation_scope.name, "")`,
      `set(instrumentation_scope.version, "")`,
      `keep_keys(instrumentation_scope.attributes, [])`,
      `set(resource.attributes["service.name"], "synthetic-partner-service")`,
      `set(resource.attributes["deployment.environment"], "LOCAL_SYNTHETIC")`,
      `set(resource.attributes["market"], "LOCAL")`,
      `set(resource.attributes["event.domain"], log.attributes["event.domain"])`,
      `set(resource.attributes["event.type"], log.attributes["event.type"])`,
      `set(resource.attributes["direction"], log.attributes["direction"])`,
      `set(resource.attributes["outcome"], log.attributes["outcome"])`,
      `set(resource.attributes["severity"], log.attributes["severity"])`,
      `keep_keys(resource.attributes, ["service.name", "deployment.environment", "market", "event.domain", "event.type", "direction", "outcome", "severity"])`,
      `keep_keys(log.attributes, ["event.id", "interaction.id", "callback.attempt.id", "correlation.profile.id", "timeline.stage", "api.id", "service.version", "status.class", "error.code", "application.id", "loan.id", "correlation.id", "original.correlation.id", "request.id", "partner.reference.id", "callback.reference.id", "external.transaction.id"])`,
    ]
  }
  output {
    logs = [otelcol.exporter.otlphttp.partner_a.input]
  }
}

