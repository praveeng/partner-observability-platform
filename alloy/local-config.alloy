otelcol.exporter.otlphttp "partner_a" {
  client {
    endpoint = "http://loki:3100/otlp"
    timeout = "1s"
    headers = { "X-Scope-OrgID" = "local-p001-7f3a" }
    tls { insecure = true }
  }
  retry_on_failure {
    enabled = true
    initial_interval = "200ms"
    max_interval = "1s"
    max_elapsed_time = "2s"
  }
  sending_queue {
    enabled = true
    block_on_overflow = false
    num_consumers = 1
    queue_size = 64
    sizer = "requests"
    wait_for_result = false
  }
}

