        "queryMixPercent": {"applicationId": 30, "loanId": 20, "correlationId": 15, "partnerReferenceId": 10, "callbackReferenceId": 10, "unifiedJourney": 10, "detail": 5}
      },
      "executions": [{"id": "bounded-resolver", "dependencyState": "healthy", "mappedScenarios": []}],
      "thresholds": [
        {"id": "query-p95", "metric": "queryP95Seconds", "operator": "<=", "value": 5},
        {"id": "query-max", "metric": "maximumQuerySeconds", "operator": "<=", "value": 10},
        {"id": "time-limit", "metric": "timeLimitHeld", "operator": "==", "value": true},
        {"id": "key-limit", "metric": "keyLimitHeld", "operator": "==", "value": true},
        {"id": "round-limit", "metric": "roundLimitHeld", "operator": "==", "value": true},
        {"id": "record-limit", "metric": "recordLimitHeld", "operator": "==", "value": true},
        {"id": "response-size", "metric": "responseBytes", "operator": "<=", "value": 2097152},
